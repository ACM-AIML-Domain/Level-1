import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error

%matplotlib inline

# Load the dataset
df_boston = pd.read_csv('Boston.csv')

# Display the first few rows
display(df_boston.head())

# Display dataset info
print(df_boston.info())

# Drop the unnecessary index column
df = df_boston.drop(columns=['Unnamed: 0'])

# Define features (X) and target (y)
X = df.drop(columns=['medv'])
y = df['medv']

print("Features shape:", X.shape)
print("Target shape:", y.shape)

# Initialize the model
model = LinearRegression()

# Fit the model to the data
model.fit(X, y)

intercept = model.intercept_
coefficients = model.coef_
feature_names = X.columns.tolist()

print(f"Model Intercept (Bias): {intercept:.4f}")
print("\nCoefficients (Weights):")
for name, coef in zip(feature_names, coefficients):
    print(f"  {name:<10}: {coef:.4f}")

# Generate predictions
predictions = model.predict(X)

# Calculate Squared Error metrics
mse = mean_squared_error(y, predictions)
sse = np.sum((y - predictions) ** 2)

print(f"Mean Squared Error (MSE): {mse:.4f}")
print(f"Sum of Squared Errors (SSE): {sse:.4f}")

plt.figure(figsize=(8, 6))
plt.scatter(y, predictions, alpha=0.6, color='b')
plt.plot([y.min(), y.max()], [y.min(), y.max()], 'r--', lw=2)  # Diagonal line
plt.xlabel('Actual Values (medv)')
plt.ylabel('Predicted Values')
plt.title('Actual vs Predicted Housing Prices')
plt.grid(True)
plt.show()